      {
        "method": "POST",
        "path": "/api/v1/agent/loadTests/compare",
        "mode": "read",
        "entity": "report",
        "body": [
          {
            "name": "baselineRunId",
            "type": "string",
            "required": true,
            "description": "Run UUID to compare against."
          },
          {
            "name": "candidateRunId",
            "type": "string",
            "required": true,
            "description": "Run UUID being evaluated; must differ from baselineRunId."
          },
          {
            "name": "dimensions",
            "type": "array",
